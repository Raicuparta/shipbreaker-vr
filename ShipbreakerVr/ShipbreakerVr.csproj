<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ShipbreakerVr</AssemblyName>
    <Version>0.4.44</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(PublishDir)BepInEx\plugins\ShipbreakerVr\</OutputPath>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(GameManagedDir)\*.dll" Exclude="$(GameManagedDir)\System*.dll;$(GameManagedDir)\mscorlib.dll;$(GameManagedDir)\netstandard.dll;$(GameManagedDir)\Mono*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>ModFiles\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>ModFiles\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(UnityManagedDir)\Unity.InputSystem.dll;$(UnityManagedDir)\Unity.XR.Management.dll;$(UnityManagedDir)\Unity.XR.OpenXR*.dll;$(UnityManagedDir)\Unity.Subsystem.Registration.dll">
      <Private>true</Private>
    </Reference>
    <Content Include="..\ShipbreakerVrUnity\AssetBundles\xrmanager;$(UnityProjectDir)\AssetBundles\debugrays">
      <Link>AssetBundles\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="ValidateDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManagedDir)\BBI.Unity.Game.dll')" Text="Set GameDir to your installed Shipbreaker folder (containing Shipbreaker.exe). See docs/BUILD.md." />
    <Error Condition="!Exists('$(UnityManagedDir)\Unity.XR.OpenXR.dll')" Text="Unity runtime dependencies are missing. Run scripts/build.ps1 with the pinned Unity editor and GameDir." />
    <Error Condition="!Exists('$(UnityProjectDir)\AssetBundles\debugrays')" Text="Build the debugrays asset bundle using the pinned Unity editor before compiling the mod." />
  </Target>
  <Target Name="CopyModFiles" AfterTargets="Build">
    <ItemGroup><ModFiles Include="ModFiles\**\*" /></ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
